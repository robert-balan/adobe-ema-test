{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Xray QA test plan",
  "description": "Reviewable intermediate artifact produced by the qa-xray agent and consumed by .claude/scripts/xray-push.mjs.",
  "type": "object",
  "required": [
    "project",
    "tests"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "description": "Jira project key the Tests are created in, e.g. \"EC\"."
    },
    "source": {
      "type": "object",
      "description": "The ticket these tests were derived from.",
      "properties": {
        "key": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "key"
      ]
    },
    "folder": {
      "type": "string",
      "description": "Default Xray Test Repository folder path, e.g. \"/Header/Megamenu\"."
    },
    "testSets": {
      "type": "object",
      "description": "Optional override of the Test Set summary per suite. Omit it — the default is three project-wide sets (\"Sanity testing\", \"Regression testing\", \"E2E testing\") that accumulate tests across every ticket. Naming them here creates ticket-scoped sets instead, since the registry is keyed by summary.",
      "properties": {
        "sanity": {
          "type": "string"
        },
        "regression": {
          "type": "string"
        },
        "e2e": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "ac",
          "suites",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+-TC-[0-9]{2,}$",
            "description": "Stable idempotency key, e.g. EC-18-TC-01. Never renumber."
          },
          "summary": {
            "type": "string",
            "description": "Jira summary: \"[TICKET] AC-n — assertion\"."
          },
          "ac": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Acceptance criteria this test traces to."
          },
          "suites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "sanity",
                "regression",
                "e2e"
              ]
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra dimension labels; whitespace is hyphenated on push."
          },
          "precondition": {
            "type": "string",
            "description": "Fixture/environment state required before step 1."
          },
          "notes": {
            "type": "string"
          },
          "folder": {
            "type": "string",
            "description": "Overrides plan.folder for this test."
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "action",
                "result"
              ],
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "data": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "projectId": {
      "type": "string",
      "description": "Numeric Jira project id, required only to pre-create the Test Repository folder (EC = 11590)."
    },
    "assignee": {
      "type": "string",
      "description": "Atlassian accountId to assign every created Test to. Omit to leave unassigned."
    }
  }
}
